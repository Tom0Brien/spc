<mujoco model="K1">
  <!-- Booster K1 (serial ankle) as trained in booster_mjlab
       (https://github.com/IntelligentRoboticsLab/booster_mjlab, d92e113).
       Geometry, inertials and joint ranges come from its xmls/k1.xml; the
       actuators, armature and collision properties are what mjlab applies on
       top (k1_constants.py: K1_ARTICULATION, FULL_COLLISION), cross-checked
       against the compiled website/static/demo/k1_web.xml. -->
  <compiler angle="radian" meshdir="assets" autolimits="true"/>

  <!-- Velocity task SimulationCfg: dt=0.005 (policy runs at decimation 4 -> 50 Hz). -->
  <option timestep="0.005" integrator="implicitfast" iterations="10" ls_iterations="20" ccd_iterations="60"/>

  <asset>
    <material name="light_gray" rgba="0.65 0.65 0.65 1"/>
    <material name="medium_gray" rgba="0.2 0.2 0.2 1"/>

    <mesh file="Trunk_1.STL"/>
    <mesh file="Trunk_2.STL"/>
    <mesh file="K1logo.STL"/>
    <mesh file="Head_1.STL"/>
    <mesh file="Head_2.STL"/>
    <mesh file="Left_Arm_1.STL"/>
    <mesh file="Left_Arm_2.STL"/>
    <mesh file="Left_Arm_3.STL"/>
    <mesh file="Left_Arm_4.STL"/>
    <mesh file="Right_Arm_1.STL"/>
    <mesh file="Right_Arm_2.STL"/>
    <mesh file="Right_Arm_3.STL"/>
    <mesh file="Right_Arm_4.STL"/>
    <mesh file="Left_Hip_Pitch.STL"/>
    <mesh file="Left_Hip_Roll.STL"/>
    <mesh file="Left_Hip_Yaw.STL"/>
    <mesh file="Left_Shank.STL"/>
    <mesh file="Left_Ankle_Cross.STL"/>
    <mesh file="Left_Foot.STL"/>
    <mesh file="Right_Hip_Pitch.STL"/>
    <mesh file="Right_Hip_Roll.STL"/>
    <mesh file="Right_Hip_Yaw.STL"/>
    <mesh file="Right_Shank.STL"/>
    <mesh file="Right_Ankle_Cross.STL"/>
    <mesh file="Right_Foot.STL"/>
  </asset>

  <default>
    <default class="k1">
      <geom solref="0.001 1"/>
      <site size="0.01" group="5"/>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2" density="0" material="medium_gray"/>
      </default>
      <!-- FULL_COLLISION: self-collisions on, soft contacts (solmix=0.001) so
           the floor's solref/solimp dominate, limb friction 0.45, feet 1.0. -->
      <default class="collision">
        <geom group="3" contype="1" conaffinity="1" condim="3" friction="0.45" solref="0.01 1" solmix="0.001"
          rgba="0.75294 0.75294 0.75294 1"/>
        <default class="foot">
          <geom type="mesh" friction="1"/>
        </default>
      </default>

      <!-- PD gains and effort limits per Booster motor (k1_constants.py).
           Targets are unclamped (ctrllimited=false), as in training. -->
      <default class="head">
        <joint armature="0.001"/>
        <position kp="4" kv="0.25" forcerange="-6 6"/>
      </default>
      <default class="arm">
        <joint armature="0.001"/>
        <position kp="10" kv="1" forcerange="-14 14"/>
      </default>
      <default class="hip_pitch">
        <joint armature="0.0478125"/>
        <position kp="80" kv="4" forcerange="-68 68"/>
      </default>
      <default class="hip_roll">
        <joint armature="0.0339552"/>
        <position kp="80" kv="4" forcerange="-76 76"/>
      </default>
      <default class="hip_yaw">
        <joint armature="0.0282528"/>
        <position kp="80" kv="4" forcerange="-38.3 38.3"/>
      </default>
      <default class="knee">
        <joint armature="0.095625"/>
        <position kp="80" kv="4" forcerange="-112 112"/>
      </default>
      <default class="ankle">
        <joint armature="0.0565056"/>
        <position kp="50" kv="2" forcerange="-38.3 38.3"/>
      </default>
    </default>
  </default>

