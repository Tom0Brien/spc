  <!-- Actuators follow the joint order (head, left arm, right arm, left leg,
       right leg), which is also the policy's joint order. -->
  <actuator>
    <position class="head" name="Head_Yaw" joint="Head_Yaw"/>
    <position class="head" name="Head_Pitch" joint="Head_Pitch"/>

    <position class="arm" name="Left_Shoulder_Pitch" joint="Left_Shoulder_Pitch"/>
    <position class="arm" name="Left_Shoulder_Roll" joint="Left_Shoulder_Roll"/>
    <position class="arm" name="Left_Elbow_Pitch" joint="Left_Elbow_Pitch"/>
    <position class="arm" name="Left_Elbow_Yaw" joint="Left_Elbow_Yaw"/>

    <position class="arm" name="Right_Shoulder_Pitch" joint="Right_Shoulder_Pitch"/>
    <position class="arm" name="Right_Shoulder_Roll" joint="Right_Shoulder_Roll"/>
    <position class="arm" name="Right_Elbow_Pitch" joint="Right_Elbow_Pitch"/>
    <position class="arm" name="Right_Elbow_Yaw" joint="Right_Elbow_Yaw"/>

    <position class="hip_pitch" name="Left_Hip_Pitch" joint="Left_Hip_Pitch"/>
    <position class="hip_roll" name="Left_Hip_Roll" joint="Left_Hip_Roll"/>
    <position class="hip_yaw" name="Left_Hip_Yaw" joint="Left_Hip_Yaw"/>
    <position class="knee" name="Left_Knee_Pitch" joint="Left_Knee_Pitch"/>
